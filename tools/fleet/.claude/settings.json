      "Artifact",
      "SendUserFile",
      "ReportFindings",
      "SendMessage",
      "PushNotification",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "CronCreate",
      "CronDelete",
      "CronList",
      "Monitor",
      "EnterPlanMode",
      "ExitPlanMode",
      "mcp__Claude_Browser",
      "mcp__visualize",
      "mcp__ccd_session",
      "mcp__ccd_session_mgmt",
      "mcp__mcp-registry",
      "mcp__scheduled-tasks",
      "EnterWorktree",
      "ExitWorktree",
